# Copy this file to .env for local development.
# Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-value
# Prefer the namespaced variable when the parent directory has another app.
CAMPUSPULSE_DATABASE_URL=sqlite:///college_event.db
# DATABASE_URL may still be used for a CampusPulse deployment.

# Local runtime
CAMPUSPULSE_BROWSER=1
CAMPUSPULSE_PORT=5000
AUTO_CREATE_DB=0

# Cookie/security settings
SESSION_COOKIE_SECURE=0
WTF_CSRF_TIME_LIMIT=3600

# Report retention
REPORT_RETENTION_DAYS=30
MAX_REPORT_FILES=100
MAX_CONTENT_LENGTH=2097152

# ---------------------------------------------------------------------------
# Campus geolocation verification (constant reference point)
# Coordinates supplied by the college. These anchor distance calculations but
# do NOT by themselves define the campus boundary.
# ---------------------------------------------------------------------------
CAMPUS_NAME=College of Applied Sciences, Adoor (IHRD)
CAMPUS_ADDRESS=Hospital, Link Road, Parass La, Adoor, Kerala, India - 691523
CAMPUS_LATITUDE=9.1557
CAMPUS_LONGITUDE=76.7369
CAMPUS_RADIUS_M=250
# Optional GeoJSON Polygon with a verified campus boundary. When set and
# parseable it replaces the circular-radius check.
CAMPUS_POLYGON_FILE=
# A GPS reading coarser than this cannot support a conclusive verdict.
GPS_MAX_RELIABLE_ACCURACY_M=100

# ---------------------------------------------------------------------------
# Image comparison against campus reference images
# ---------------------------------------------------------------------------
# Indicative starting threshold. NOT a validated decision boundary: calibrate
# it against real campus photographs before relying on it.
IMAGE_SIMILARITY_THRESHOLD=0.92
# 'perceptual' (default, Pillow only) or 'clip' (needs PyTorch + open_clip).
IMAGE_EMBEDDING_BACKEND=perceptual
# Drop up to five campus photographs in this folder.
REFERENCE_IMAGE_FOLDER=
REFERENCE_IMAGE_CACHE_FILE=
MAX_REFERENCE_IMAGE_BYTES=10485760

# ---------------------------------------------------------------------------
# Privacy: location records and photos expire after this many days.
# Run `flask --app run.py purge-verification-records` on a schedule.
# ---------------------------------------------------------------------------
VERIFICATION_RETENTION_DAYS=180
MAX_VERIFICATION_IMAGE_BYTES=409600
ATTENDANCE_FOLDER=

# Support contact shown in the website footer, /contact, and assistant.
SUPPORT_NAME=Edwin J Anil
SUPPORT_ROLE=Developer
SUPPORT_EMAIL=edwinjanil5@gmail.com
SUPPORT_PHONE=8138815144

# Administrators are provisioned with the CLI, not environment variables:
# flask --app run.py create-admin
