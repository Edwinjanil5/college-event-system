# Copy this file to .env for local development.
# Never commit the real .env file.

SECRET_KEY=replace-with-a-long-random-value
# Prefer the namespaced variable when the parent directory has another app.
CAMPUSPULSE_DATABASE_URL=sqlite:///college_event.db
# DATABASE_URL may still be used for a CampusPulse deployment.

# Local runtime
CAMPUSPULSE_BROWSER=1
CAMPUSPULSE_PORT=5000
AUTO_CREATE_DB=0

# Cookie/security settings
SESSION_COOKIE_SECURE=0
WTF_CSRF_TIME_LIMIT=3600

# Report retention
REPORT_RETENTION_DAYS=30
MAX_REPORT_FILES=100
MAX_CONTENT_LENGTH=2097152

# Support contact shown in the website footer, /contact, and assistant.
SUPPORT_NAME=Edwin J Anil
SUPPORT_ROLE=Developer
SUPPORT_EMAIL=edwinjanil5@gmail.com
SUPPORT_PHONE=8138815144

# Administrators are provisioned with the CLI, not environment variables:
# flask --app run.py create-admin
